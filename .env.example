# Copy to .env and adjust: cp .env.example .env
# Used by docker-compose.yml / docker-compose.prod.yml

# PostgreSQL
POSTGRES_USER=gymflow
POSTGRES_PASSWORD=gymflow
POSTGRES_DB=gymflow

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend (URL of the API as seen from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
