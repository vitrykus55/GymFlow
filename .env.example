# Copy to .env and adjust: cp .env.example .env
# Used by docker-compose.yml / docker-compose.prod.yml

# Neon (development Backend)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# PostgreSQL (production Compose only)
POSTGRES_USER=gymflow
POSTGRES_PASSWORD=gymflow
POSTGRES_DB=gymflow

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_32_BYTE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=gymflow_refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
# Defaults to true when ENVIRONMENT=production and false otherwise.
# Set true whenever HTTPS is used; SameSite=none also requires true.
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax
# REFRESH_TOKEN_COOKIE_DOMAIN=

# Frontend (URL of the API as seen from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
